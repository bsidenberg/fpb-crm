{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run lint)",
      "Bash(npm test:*)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run test:watch)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ -d node_modules ] || npm install --no-audit --no-fund"
          }
        ]
      }
    ]
  }
}
